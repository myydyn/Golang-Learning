{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      "@*": ["*"],
      "@modules/*": ["modules/*"],
      "@share/*": ["share/*"]
    }
  },
}
